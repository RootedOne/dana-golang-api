# AI Provider Settings
# "google" = native Gemini API (only when AI_BASE_URL is empty)
# "openai" = OpenAI-compatible chat/completions (Groq, DeepSeek, OpenAI, etc.)
AI_PROVIDER=openai

# Model Selection
# Google native: gemini-2.0-flash-lite-preview-02-05
# Groq example: llama-3.3-70b-versatile
# DeepSeek example: deepseek-chat
AI_MODEL=llama-3.3-70b-versatile

# Your AI API Key (sent as: Authorization: Bearer <key>)
AI_API_KEY=your_key_here

# OpenAI-compatible base URL (Groq, DeepSeek, Ollama, Together.ai, etc.)
# Examples:
#   https://api.groq.com/openai/v1
#   https://api.deepseek.com/v1
# Leave empty only when AI_PROVIDER=google with no custom proxy.
AI_BASE_URL=https://api.groq.com/openai/v1

# Model Temperature
AI_TEMPERATURE=0.1

# Service mode: "movie" or "music"
# Use MODE=music for music identification (prompts/music.xml)
MODE=movie

# Rate limiting (protects AI API quota)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SEC=60

# TMDB Settings (movie mode only)
# Used for fetching official, high-quality movie posters
TMDB_API_KEY=your_tmdb_api_key_here
